# Build-time only. The agent itself reads nothing from a .env at runtime —
# the server address is entered by the employee at first sign-in and the
# rest comes from the server.

# Optional: pre-fill the HRMS address on the sign-in screen so employees do
# not have to type it. Useful when building an installer for one company.
HRMS_URL=https://hrms.yourdeveloperonline.com

# Code signing, consumed by electron-builder. Never commit real values.
# CSC_LINK=./certs/hike-branding.pfx
# CSC_KEY_PASSWORD=
